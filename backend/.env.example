# Cleaneco Backend Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real credentials.

# Server Port (Default: 5000)
PORT=5000

# Client Application URL (e.g., http://localhost:3000 for local development, or your Vercel URL in production)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cleaneco

# JWT Secret Key for Session Authentication (Use a secure random 256-bit string)
JWT_SECRET=your_jwt_secret_key_here

# EmailJS Service Configuration (Used for verification, receipts, password resets)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_USER_ID=your_emailjs_user_id_public_key
EMAILJS_ACCESS_TOKEN=your_emailjs_private_access_token

# Optional Fallback SMTP (if needed)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# PayMongo Payment Gateway API Keys
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET_KEY=whsk_your_paymongo_webhook_secret_key
