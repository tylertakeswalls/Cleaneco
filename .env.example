# Cleaneco Frontend Environment Variables Template
# Copy this file to .env and replace with your local or production backend URL.

GENERATE_SOURCEMAP=false

# Backend API Base URL
# For local development: http://localhost:5000
# For production: https://your-render-backend-url.onrender.com
REACT_APP_API_URL=http://localhost:5000

# Optional PayMongo Public Key (if needed by frontend SDKs)
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key
